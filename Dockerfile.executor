# ==========================================
# Production Dockerfile for Tandem Executor Service
# ==========================================

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_PATH=/app/node_modules:/app/services/executor/node_modules

# Copy root workspace structure
COPY package.json pnpm-workspace.yaml ./
COPY node_modules ./node_modules

# Copy SDK artifacts
COPY packages/sdk/package.json ./packages/sdk/package.json
COPY packages/sdk/dist ./packages/sdk/dist
COPY packages/sdk/node_modules ./packages/sdk/node_modules

# Copy Executor service artifacts
COPY services/executor/package.json ./services/executor/package.json
COPY services/executor/dist ./services/executor/dist
COPY services/executor/node_modules ./services/executor/node_modules

USER node

EXPOSE 3001

CMD ["node", "services/executor/dist/index.js"]
