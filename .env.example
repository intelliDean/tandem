# =================================================================
# Tandem Spread Orders - Environment Configuration
# =================================================================

# Network Configuration
# 10143 = Monad Testnet | 143 = Monad Mainnet / Local Fork
CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed TandemSpreadRouter Address
TANDEM_ROUTER_ADDRESS=0xC7885f87e2027F90D8cd4372CE5071b3aFE19E91

# Executor Bot Private Key (authorized to dispatch limit spread transactions)
# Leave empty to use default local dev key
EXECUTOR_PRIVATE_KEY=

# Ports
WEB_PORT=3000
EXECUTOR_PORT=3001
