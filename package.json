{
  "name": "tandem-spread-orders",
  "version": "1.0.0",
  "private": true,
  "description": "Atomic spread orders on Monad combining Kuru CLOB spot and Perpl DEX perpetuals",
  "scripts": {
    "test:contracts": "forge test --fork-url https://rpc.monad.xyz --fork-block-number 109312895",
    "build:contracts": "forge build",
    "build": "pnpm -r run build",
    "test:e2e": "pnpm --filter @tandem/executor test:e2e",
    "dev:executor": "pnpm --filter @tandem/executor dev",
    "dev:web": "pnpm --filter @tandem/web dev",
    "docker:build": "pnpm build && docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0"
  }
}
